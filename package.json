{
  "name": "tether",
  "version": "0.0.0",
  "private": true,
  "description": "Control your Android phone from your Windows PC.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm test -w @tether/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @tether/desktop"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
